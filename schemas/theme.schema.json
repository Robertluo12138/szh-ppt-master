{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "theme.schema.json",
  "title": "Template Theme",
  "description": "Default design tokens for a template. design_system.json is derived from this plus any deck-plan overrides. Keep this schema in sync with design_system.schema.json.",
  "type": "object",
  "required": ["name", "version", "palette", "typography", "grid"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["scaffold", "draft", "stable"]
    },
    "palette": {
      "type": "object",
      "required": ["primary", "background", "text"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "properties": {
        "primary":    { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary":  { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent":     { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "text":       { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["heading", "body"],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "object",
          "required": ["font_family", "size_pt"],
          "additionalProperties": false,
          "properties": {
            "font_family": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^,]+(\\s*,\\s*[^,]+)*$",
              "description": "CSS-style fallback chain, ordered preferred -> fallback. See references/style-guide.md."
            },
            "size_pt": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "body": {
          "type": "object",
          "required": ["font_family", "size_pt"],
          "additionalProperties": false,
          "properties": {
            "font_family": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^,]+(\\s*,\\s*[^,]+)*$"
            },
            "size_pt": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "required": ["width_px", "height_px", "margin_px"],
      "additionalProperties": false,
      "properties": {
        "width_px":  { "type": "integer", "exclusiveMinimum": 0 },
        "height_px": { "type": "integer", "exclusiveMinimum": 0 },
        "margin_px": { "type": "integer", "minimum": 0 }
      }
    },
    "todo": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
