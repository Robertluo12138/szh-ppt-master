{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "image_manifest.schema.json",
  "title": "Image Manifest",
  "description": "Lists every image asset that appears in the deck. Every entry is a local file inside the workspace. External URLs are forbidden. Images are spot illustrations / icons / decorative artwork only; never full-slide screenshots.",
  "type": "object",
  "required": ["images"],
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "local_path", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative path. Must not contain '..' or start with '/'. The security scan enforces this."
          },
          "source": {
            "type": "string",
            "enum": ["local_asset", "d_one_local", "synthetic"]
          },
          "alt_text": {
            "type": "string"
          },
          "intended_use": {
            "type": "string",
            "description": "E.g. 'spot illustration', 'icon', 'decorative pattern'. Never 'full-slide background'."
          },
          "width_px": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "height_px": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
